# ==============================================================================
# UPSTOX DEVELOPER API CREDENTIALS
# ==============================================================================
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_REDIRECT_URI=https://127.0.0.1:5000/
UPSTOX_MOBILE=9876543210
UPSTOX_PIN=123456
UPSTOX_TOTP_SECRET=YOUR_32_CHAR_BASE32_TOTP_KEY
# Optional fallback if token generated manually:
UPSTOX_ACCESS_TOKEN=

# ==============================================================================
# FIREBASE CREDENTIALS (SPARK FREE TIER)
# ==============================================================================
# Paste the entire contents of your Firebase service-account JSON as a single-line string,
# or provide the local file path:
FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}
AUTHORIZED_USER_EMAIL=your_email@gmail.com

# ==============================================================================
# TRADING & SAFETY SETTINGS (PAPER TRADING DEFAULT)
# ==============================================================================
DRY_RUN=true
INDEX_NAME=NIFTY
LOT_SIZE=75
MAX_RISK_PER_TRADE=1500
DAILY_MAX_LOSS=4000
MAX_CONSECUTIVE_SL=3
